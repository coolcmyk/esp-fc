# OV5647 MIPI-CSI camera and JPEG encoder for the video recorder
CONFIG_CAMERA_OV5647=y
# Frame buffers live in PSRAM (800x800 RGB565 does not fit internal SRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_FATFS_LFN_STACK=y
CONFIG_FATFS_MAX_LFN=64
